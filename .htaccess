<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and sensitive directories
    RewriteRule ^\.env.*$ - [F,L,NC]
    RewriteRule ^\.git.*$ - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^package(-lock)?\.json$ - [F,L,NC]
    RewriteRule ^storage/logs/ - [F,L,NC]
    RewriteRule ^storage/framework/ - [F,L,NC]
    RewriteRule ^vendor/ - [F,L,NC]
    RewriteRule ^bootstrap/cache/.*\.php$ - [F,L,NC]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send all requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory browsing
Options -Indexes
